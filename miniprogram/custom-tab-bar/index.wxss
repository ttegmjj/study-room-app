/* custom-tab-bar/index.wxss */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-around;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.06);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 10rpx 0;
  color: #999;
  transition: color 0.2s;
}

.tab-active {
  color: #4A90D9;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.tab-text {
  font-size: 22rpx;
  margin-top: 4rpx;
}
