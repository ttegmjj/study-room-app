.container { padding: 24rpx; background: linear-gradient(180deg, #F1F8E9 0%, #FFFFFF 400rpx); min-height: 100vh; }

.header { padding: 32rpx 0 24rpx; }
.header-title { font-size: 44rpx; font-weight: 700; color: #2E7D32; }
.header-sub { font-size: 24rpx; color: #888; margin-top: 8rpx; }

.presets { margin-bottom: 20rpx; }
.presets-title { font-size: 26rpx; color: #666; margin-bottom: 12rpx; }
.preset-list { display: flex; flex-wrap: wrap; gap: 12rpx; }
.preset-item {
  font-size: 24rpx; padding: 10rpx 20rpx; border-radius: 24rpx;
  background: #E8F5E9; color: #2E7D32; border: 1rpx solid #C8E6C9;
}

.input-card {
  background: #fff; border-radius: 20rpx; padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05); margin-bottom: 24rpx;
}
.input-area {
  width: 100%; min-height: 120rpx; font-size: 28rpx; color: #333;
  padding: 16rpx 0; box-sizing: border-box; line-height: 1.6;
}
.actions { display: flex; align-items: center; justify-content: space-between; padding-top: 16rpx; border-top: 1rpx solid #F0F0F0; }
.model-tag { font-size: 22rpx; color: #888; background: #F5F5F5; padding: 6rpx 14rpx; border-radius: 12rpx; }
.btn-row { display: flex; gap: 16rpx; }
.btn { font-size: 26rpx; padding: 12rpx 28rpx; border-radius: 28rpx; text-align: center; }
.btn-ghost { background: #F5F5F5; color: #666; }
.btn-primary { background: linear-gradient(135deg, #43A047, #66BB6A); color: #fff; font-weight: 500; }
.btn.disabled { opacity: 0.6; }

.output-card {
  background: #fff; border-radius: 20rpx; padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05); margin-bottom: 24rpx;
  border-left: 6rpx solid #66BB6A;
}
.output-head { display: flex; justify-content: space-between; margin-bottom: 12rpx; }
.output-title { font-size: 28rpx; font-weight: 600; color: #2E7D32; }
.output-copy { font-size: 24rpx; color: #43A047; }
.output-body { font-size: 28rpx; color: #333; line-height: 1.7; min-height: 60rpx; white-space: pre-wrap; }
.cursor { color: #66BB6A; animation: blink 0.8s infinite; }
@keyframes blink { 50% { opacity: 0; } }

.tech-card {
  background: #FAFAFA; border-radius: 16rpx; padding: 20rpx 24rpx;
  border: 1rpx dashed #DDD;
}
.tech-title { font-size: 26rpx; color: #666; margin-bottom: 10rpx; font-weight: 600; }
.tech-line { font-size: 22rpx; color: #999; line-height: 1.8; font-family: monospace; }
