/* pages/forum/post-detail/post-detail.wxss */
.detail-page {
  padding-bottom: 160rpx;
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.avatar.small {
  width: 60rpx;
  height: 60rpx;
}

.avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef4fb;
  font-size: 34rpx;
}

.detail-head {
  display: flex;
  align-items: center;
  margin-bottom: 22rpx;
}

.head-info {
  flex: 1;
  min-width: 0;
}

.author-name {
  font-size: 27rpx;
  color: #333;
  font-weight: 500;
}

.post-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.cat-badge {
  font-size: 22rpx;
  color: #4A90D9;
  background: #eef4fb;
  border-radius: 20rpx;
  padding: 6rpx 18rpx;
}

.detail-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #222;
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.detail-content {
  font-size: 28rpx;
  color: #444;
  line-height: 1.75;
  white-space: pre-wrap;
}

.info-list {
  margin-top: 24rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 8rpx 24rpx;
}

.info-line {
  display: flex;
  padding: 14rpx 0;
  font-size: 26rpx;
}

.info-key {
  width: 180rpx;
  color: #999;
  flex-shrink: 0;
}

.info-val {
  flex: 1;
  color: #333;
}

.contact-box {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: #f2f7fd;
  border: 2rpx dashed #a8c8ec;
  border-radius: 12rpx;
}

.contact-left {
  flex: 1;
}

.contact-label {
  font-size: 22rpx;
  color: #7a9cc4;
}

.contact-val {
  font-size: 30rpx;
  color: #2c6aa0;
  font-weight: 500;
  margin-top: 4rpx;
}

.contact-copy {
  font-size: 24rpx;
  color: #fff;
  background: #4A90D9;
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
}

.delete-btn {
  margin-top: 26rpx;
  text-align: center;
  font-size: 26rpx;
  color: #ff6b6b;
  padding: 16rpx;
  border-top: 1rpx solid #f0f2f5;
}

.action-card {
  display: flex;
  justify-content: space-around;
  padding: 24rpx;
}

.action-item {
  font-size: 26rpx;
  color: #666;
}

.action-item.liked {
  color: #ff6b6b;
}

.card-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
}

.no-comment {
  text-align: center;
  color: #bbb;
  font-size: 25rpx;
  padding: 30rpx 0;
}

.comment-item {
  display: flex;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f5f7fa;
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-body {
  flex: 1;
  min-width: 0;
}

.comment-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.comment-name {
  font-size: 25rpx;
  color: #4A90D9;
}

.comment-time {
  font-size: 21rpx;
  color: #bbb;
}

.comment-text {
  font-size: 26rpx;
  color: #444;
  line-height: 1.6;
  margin-top: 8rpx;
  word-break: break-all;
}

/* 底部评论栏 */
.comment-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.comment-input {
  flex: 1;
  height: 68rpx;
  background: #f5f6fa;
  border-radius: 34rpx;
  padding: 0 26rpx;
  font-size: 26rpx;
}

.ph {
  color: #bbb;
}

.send-btn {
  margin-left: 18rpx;
  font-size: 26rpx;
  color: #bbb;
  padding: 10rpx 16rpx;
}

.send-active {
  color: #4A90D9;
  font-weight: 500;
}
