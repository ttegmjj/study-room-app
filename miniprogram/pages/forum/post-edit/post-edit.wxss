/* pages/forum/post-edit/post-edit.wxss */
.card-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 16rpx;
}

.form-row {
  display: flex;
  align-items: center;
  min-height: 88rpx;
}

.form-label {
  width: 170rpx;
  flex-shrink: 0;
  font-size: 27rpx;
  color: #666;
}

.form-input {
  flex: 1;
  font-size: 27rpx;
  color: #333;
}

.picker-value {
  font-size: 27rpx;
  color: #4A90D9;
}

.form-block {
  padding: 16rpx 0 0;
}

.form-textarea {
  width: 100%;
  min-height: 240rpx;
  margin-top: 14rpx;
  font-size: 27rpx;
  line-height: 1.6;
  color: #333;
  box-sizing: border-box;
}

.ph {
  color: #bbb;
  font-size: 26rpx;
}

.counter {
  text-align: right;
  font-size: 22rpx;
  color: #bbb;
}

.submit-btn {
  margin-top: 40rpx;
}

.submit-btn.disabled {
  opacity: 0.6;
}

.tip {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
}
