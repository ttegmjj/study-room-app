/* pages/admin/admin.wxss */

.no-permission {
  text-align: center;
  padding: 150rpx 40rpx;
}

.no-perm-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.no-perm-text {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

.no-perm-tip {
  font-size: 26rpx;
  color: #999;
  margin-top: 10rpx;
}

.bootstrap-btn {
  margin: 40rpx auto 0;
  width: 380rpx;
  padding: 20rpx 0;
  background: #4A90D9;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
}

.bootstrap-tip {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 16rpx;
}

.admin-header {
  padding: 30rpx 10rpx;
}

.admin-title {
  font-size: 42rpx;
  font-weight: bold;
  color: #333;
}

.admin-sub {
  font-size: 26rpx;
  color: #999;
  margin-top: 6rpx;
}

.stats-grid {
  display: flex;
  padding: 30rpx;
}

.grid-item {
  flex: 1;
  text-align: center;
}

.grid-num {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
}

.grid-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.color-booked .grid-num { color: #ff9800; }
.color-checkedin .grid-num { color: #2196f3; }
.color-completed .grid-num { color: #7986cb; }

.admin-menu {
  padding: 30rpx;
}

.menu-title {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.menu-grid {
  display: flex;
  gap: 20rpx;
}

.menu-grid .menu-item {
  flex: 1;
}

.menu-item {
  background: #f8f9fb;
  border-radius: 12rpx;
  padding: 40rpx 20rpx;
  text-align: center;
}

.menu-emoji {
  font-size: 60rpx;
}

.menu-text {
  font-size: 28rpx;
  color: #333;
  margin-top: 10rpx;
  font-weight: 500;
}

/* ===== 图标图片化适配 ===== */
.no-perm-icon img {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
  overflow: hidden;
}
.menu-emoji-img {
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  overflow: hidden;
}
