/* pages/admin/notice/notice.wxss */

.container {
  padding: 24rpx;
  background: #f5f6fa;
  min-height: 100vh;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row-label {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.hint {
  font-size: 22rpx;
  color: #999;
  margin-top: 12rpx;
}

.field-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.field-input {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  margin-bottom: 24rpx;
}

.field-textarea {
  width: 100%;
  box-sizing: border-box;
  height: 200rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.count {
  text-align: right;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 8rpx;
}

.preview-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.preview-empty {
  font-size: 24rpx;
  color: #bbb;
  padding: 20rpx 0;
}

.notice-scroll {
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #3F2A00 0%, #6B4900 100%);
  overflow: hidden;
}

.notice-scroll-tag {
  flex-shrink: 0;
  font-size: 28rpx;
  margin-right: 16rpx;
}

.notice-scroll-wrap {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.notice-scroll-text {
  display: inline-block;
  white-space: nowrap;
  animation-name: notice-marquee;
  animation-duration: 16s;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}

.notice-seg {
  font-size: 25rpx;
  color: #FFE9B8;
  font-weight: 500;
  padding-right: 90rpx;
}

@keyframes notice-marquee {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(-20%);
  }
}

.notice-scroll-more {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #5C4000;
  background: #FFE0A3;
  border-radius: 20rpx;
}

.btn-save {
  margin-top: 10rpx;
  background: #4A90D9;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
}
