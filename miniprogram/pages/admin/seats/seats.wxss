/* pages/admin/seats/seats.wxss */

.info-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
}

.highlight {
  color: #4A90D9;
  font-weight: bold;
  font-size: 32rpx;
}

.info-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 16rpx;
}

.info-btn {
  padding: 12rpx 24rpx;
  background: #4A90D9;
  color: #fff;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.info-btn.danger {
  background: #ff6b6b;
}

.group-title {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 20rpx;
  color: #666;
}

.seat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.admin-seat {
  width: 100rpx;
  height: 100rpx;
  background: #f5f6fa;
  border-radius: 10rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  justify-content: center;
  position: relative;
}

.seat-code {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
}

.tag-small {
  font-size: 18rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 布局模式：间隔标记与可编辑态 */
.admin-seat.seat-editing {
  border: 2rpx dashed #4A90D9;
}

.admin-seat.seat-gap-after {
  border-right: 6rpx solid #f0a35e;
}

.gap-marker {
  width: 20rpx;
  height: 100rpx;
  border-radius: 6rpx;
  background: repeating-linear-gradient(
    to bottom,
    #f0a35e 0,
    #f0a35e 10rpx,
    transparent 10rpx,
    transparent 20rpx
  );
}

/* ============ 现场占用模式 ============ */

.info-bar-top {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6rpx;
}
.occupy-mode-hint {
  font-size: 22rpx;
  color: #E74C3C;
  background: #fdecea;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
}
.occupy-switch-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.occupy-switch-label {
  font-size: 24rpx;
  color: #E74C3C;
  font-weight: 500;
}
.occupy-legend {
  font-size: 22rpx;
  color: #E74C3C;
  margin-left: 8rpx;
}

/* 已预约（被小程序用户预约）的座位：浅蓝 */
.admin-seat.seat-booked-admin {
  background: #e8f0fe;
  border: 2rpx solid #4A90D9;
}
/* 现场占用的座位：红色 */
.admin-seat.seat-occupy-admin {
  background: #fdecea !important;
  border: 2rpx solid #E74C3C !important;
  position: relative;
}
.admin-seat.seat-occupy-admin .seat-code {
  color: #E74C3C;
  font-weight: bold;
}
.seat-badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  font-size: 18rpx;
  line-height: 1;
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  color: #fff;
  font-weight: bold;
}
.booked-badge {
  background: #4A90D9;
}
.occupy-badge {
  background: #E74C3C;
}

.tip-editing {
  color: #e8890c;
}

/* 自习室选择（从管理菜单直接进入时） */
.picker-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #666;
  padding: 10rpx 10rpx 20rpx;
}

.picker-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 10rpx;
  border-top: 1rpx solid #f0f0f0;
}

.picker-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.picker-loc {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.picker-arrow {
  font-size: 40rpx;
  color: #ccc;
}

.picker-empty {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 40rpx 0;
}

.tip {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 30rpx;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal {
  width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
}

.modal .form-item {
  margin-bottom: 24rpx;
}

.modal .form-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.modal .form-input {
  background: #f5f6fa;
  padding: 20rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
}

.modal .form-picker {
  background: #f5f6fa;
  padding: 20rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
}

.modal-btn.cancel {
  background: #f5f6fa;
  color: #666;
}

.modal-btn.confirm {
  background: #4A90D9;
  color: #fff;
}

/* ============ 过道（布局模式增强） ============ */

/* 排间过道：排之间的大间隙 */
.admin-row-gap {
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 8rpx -30rpx;
  position: relative;
}

.admin-row-gap::before,
.admin-row-gap::after {
  content: '';
  position: absolute;
  top: 50%;
  height: 2rpx;
  width: 40%;
  background: repeating-linear-gradient(
    to right,
    #c8d6e5 0,
    #c8d6e5 8rpx,
    transparent 8rpx,
    transparent 16rpx
  );
}

.admin-row-gap::before { left: 10rpx; }
.admin-row-gap::after { right: 10rpx; }

.admin-row-gap-text {
  font-size: 20rpx;
  color: #8a97a8;
  letter-spacing: 6rpx;
  background: #fff;
  padding: 0 16rpx;
  z-index: 1;
}

/* 排标题在布局模式下可点击 */
.group-title-editing {
  cursor: pointer;
  padding: 12rpx 16rpx;
  margin: -12rpx -16rpx 12rpx;
  border-radius: 12rpx;
  background: #f0f7ff;
  border: 2rpx dashed #4A90D9;
}

.group-title-with-gap {
  background: #fff5e6 !important;
  border-color: #f0a35e !important;
}

.gap-indicator {
  font-size: 20rpx;
  color: #f0a35e;
  margin-left: 8rpx;
}

.gap-indicator.gap-add {
  color: #4A90D9;
}

/* 布局模式下的过道标签 */
.seat-gap-tag {
  position: absolute;
  right: -4rpx;
  bottom: -6rpx;
  font-size: 18rpx;
  line-height: 1;
  padding: 4rpx 8rpx;
  border-radius: 6rpx;
  background: #f0a35e;
  color: #fff;
  font-weight: bold;
}
