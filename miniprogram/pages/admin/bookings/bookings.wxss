/* pages/admin/bookings/bookings.wxss */

.filter-bar {
  margin-bottom: 20rpx;
}

.date-picker {
  display: inline-block;
  padding: 16rpx 24rpx;
  background: #fff;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #333;
}

.clear-date {
  margin-left: 10rpx;
  color: #999;
}

.tab-bar {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.tab-item {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 12rpx;
  background: #fff;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #666;
}

.tab-active {
  background: #4A90D9;
  color: #fff;
}

.booking-item {
  padding-bottom: 20rpx;
}

.booking-top {
  margin-bottom: 14rpx;
}

.room-name {
  font-size: 28rpx;
  font-weight: bold;
  max-width: 400rpx;
}

.booking-info {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  font-size: 24rpx;
  color: #666;
  background: #f8f9fb;
  padding: 16rpx;
  border-radius: 8rpx;
}

.time-line {
  font-size: 22rpx;
  color: #4A90D9;
  margin-top: 10rpx;
}

.status-switch {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.switch-btn {
  padding: 14rpx 24rpx;
  background: #4A90D9;
  color: #fff;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.switch-btn.danger {
  background: #ff6b6b;
}
