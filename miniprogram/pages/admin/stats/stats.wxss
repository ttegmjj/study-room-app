/* pages/admin/stats/stats.wxss */

.filter-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.filter-left {
  font-size: 26rpx;
}

.filter-label {
  color: #999;
}

.filter-date {
  color: #4A90D9;
  font-weight: 500;
}

.clear-btn {
  margin-left: 16rpx;
  color: #ff6b6b;
  font-size: 22rpx;
}

.refresh-btn {
  font-size: 36rpx;
}

.summary-card {
  text-align: center;
}

.summary-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 30rpx;
  text-align: left;
}

.summary-total {
  margin-bottom: 40rpx;
}

.total-num {
  display: block;
  font-size: 80rpx;
  font-weight: bold;
  color: #4A90D9;
  line-height: 1;
}

.total-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.status-list {
  text-align: left;
}

.status-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.status-info {
  display: flex;
  align-items: center;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.dot-booked { background: #ff9800; }
.dot-checkedin { background: #2196f3; }
.dot-completed { background: #7986cb; }
.dot-cancelled { background: #9e9e9e; }

.status-name {
  font-size: 26rpx;
  color: #333;
}

.status-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.status-num {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
}

.status-pct {
  font-size: 24rpx;
  color: #999;
}

.progress-bar {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.progress-filled {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.3s;
}

.progress-booked { background: #ff9800; }
.progress-checkedin { background: #2196f3; }
.progress-completed { background: #7986cb; }
.progress-cancelled { background: #9e9e9e; }

.room-stat {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.room-stat:last-child {
  border-bottom: none;
}

.room-stat-top {
  margin-bottom: 10rpx;
}

.room-name {
  font-size: 28rpx;
  font-weight: 500;
  max-width: 400rpx;
}

.room-count {
  font-size: 24rpx;
  color: #4A90D9;
}

.room-stat-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.room-bar-bg {
  flex: 1;
  height: 16rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
}

.room-bar-filled {
  height: 100%;
  background: linear-gradient(90deg, #4A90D9, #357ABD);
  border-radius: 8rpx;
}

.room-pct {
  font-size: 24rpx;
  color: #666;
  min-width: 80rpx;
  text-align: right;
}

/* 运营看板 */
.kpi-row {
  display: flex;
  gap: 16rpx;
}

.kpi {
  flex: 1;
  padding: 24rpx 10rpx;
  background: #f8f9fb;
  border-radius: 14rpx;
  text-align: center;
}

.kpi-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.kpi-warn {
  color: #e6704f;
}

.kpi-blue {
  color: #4A90D9;
  font-size: 32rpx;
}

.kpi-label {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #666;
}

.kpi-sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #aab2be;
}

.hour-chart {
  margin-top: 30rpx;
}

.hour-chart-title {
  font-size: 24rpx;
  color: #8a97a8;
  margin-bottom: 16rpx;
}

.hour-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.hour-label {
  width: 90rpx;
  font-size: 22rpx;
  color: #666;
}

.hour-bar-bg {
  flex: 1;
  height: 18rpx;
  background: #f0f2f6;
  border-radius: 9rpx;
  overflow: hidden;
  margin-right: 16rpx;
}

.hour-bar {
  height: 100%;
  border-radius: 9rpx;
  background: linear-gradient(90deg, #5BA4EA, #4A90D9);
}

.hour-count {
  width: 60rpx;
  text-align: right;
  font-size: 22rpx;
  color: #8a97a8;
}

/* 近 7 天趋势 */
.trend-head {
  align-items: center;
  margin-bottom: 20rpx;
}
.export-btn {
  padding: 8rpx 22rpx;
  background: #eef4fc;
  color: #4A90D9;
  font-size: 24rpx;
  border-radius: 24rpx;
}
.trend-chart {
  display: flex;
  gap: 10rpx;
}
.trend-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.trend-bars {
  width: 100%;
  height: 180rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 6rpx;
}
.trend-bar {
  width: 22rpx;
  min-height: 4rpx;
  border-radius: 6rpx 6rpx 0 0;
}
.trend-total {
  background: #4A90D9;
}
.trend-in {
  background: #8fd3a8;
}
.trend-count {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #98a2b0;
}
.trend-label {
  font-size: 20rpx;
  color: #b0b8c4;
}
.trend-legend {
  display: flex;
  gap: 32rpx;
  margin-top: 16rpx;
}
.legend-item {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #8a97a8;
}
.legend-dot {
  width: 16rpx;
  height: 16rpx;
  margin-right: 8rpx;
  border-radius: 4rpx;
}
.legend-total {
  background: #4A90D9;
}
.legend-in {
  background: #8fd3a8;
}
